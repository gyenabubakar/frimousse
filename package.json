{
  "name": "frimousse-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "deploy": "pnpm --filter website run deploy",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter website test:e2e",
    "check": "pnpm format && pnpm -r check && pnpm lint:fix",
    "check:ci": "pnpm format:check && pnpm -r check && pnpm lint",
    "format": "prettier --cache --log-level error --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ . --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
