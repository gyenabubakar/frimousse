---
import type { SupportedLanguages } from '@pierre/diffs';
import { renderCode } from '$lib/diffs';

interface Props {
  code: string;
  lang?: SupportedLanguages;
  /** Becomes the file header. */
  title?: string;
}
const { code, lang = 'svelte', title } = Astro.props;
// Lets code be written indented inside template literals in the page.
const lines = code.replace(/^\n/, '').replace(/\s+$/, '').split('\n');
const indent = Math.min(
  ...lines.filter((line) => line.trim()).map((line) => line.match(/^ */)![0].length),
);
const source = lines.map((line) => line.slice(indent)).join('\n');
// Pre-rendered into a declarative shadow root at build time, like effectelements.com's Markdown code blocks.
const html = await renderCode(source, lang, title);
---

<div class="code-block my-5">
  <diffs-container>
    <template shadowrootmode="open" set:html={html} />
  </diffs-container>
  <button type="button" class="copy-code" aria-label="Copy code" data-code={source}>
    Copy
  </button>
</div>
