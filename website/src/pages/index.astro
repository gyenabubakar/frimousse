---
import CodeBlock from '$components/code-block.astro';
import DemoFrame from '$components/demo-frame.astro';
import ColorfulDemo from '$components/demos/colorful-demo.svelte';
import CustomSkinToneDemo from '$components/demos/custom-skin-tone-demo.svelte';
import HeroDemo from '$components/demos/hero-demo.svelte';
import OptionsDemo from '$components/demos/options-demo.svelte';
import PopoverDemo from '$components/demos/popover-demo.svelte';
import UsageDemo from '$components/demos/usage-demo.svelte';
import Heading from '$components/heading.astro';
import PropsTable from '$components/props-table.astro';
import Toc from '$components/toc.astro';
import TopBar from '$components/top-bar.astro';
import BaseLayout from '$layouts/base.astro';
import { site } from '$site';
import type { TocEntry } from '$components/toc.astro';

const SITE_URL = (Astro.site?.href ?? 'https://example.com/').replace(/\/$/, '');
const shadcnCommand = `npx shadcn-svelte@latest add ${SITE_URL}/r/emoji-picker.json`;

const toc: TocEntry[] = [
  { text: 'Installation', depth: 2 },
  { text: 'shadcn-svelte', depth: 3 },
  { text: 'Usage', depth: 2 },
  { text: 'Options', depth: 3 },
  { text: 'In a popover', depth: 3 },
  { text: 'Custom data sources and locales', depth: 3 },
  { text: 'Looking up an emoji', depth: 3 },
  { text: 'Styling', depth: 2 },
  { text: 'Dimensions', depth: 3 },
  { text: 'List padding', depth: 3 },
  { text: 'Colorful buttons', depth: 3 },
  { text: 'API Reference', depth: 2 },
  { text: 'EmojiPicker.Root', depth: 3 },
  { text: 'EmojiPicker.Search', depth: 3 },
  { text: 'EmojiPicker.Viewport', depth: 3 },
  { text: 'EmojiPicker.List', depth: 3 },
  { text: 'EmojiPicker.Loading', depth: 3 },
  { text: 'EmojiPicker.Empty', depth: 3 },
  { text: 'EmojiPicker.SkinToneSelector', depth: 3 },
  { text: 'EmojiPicker.SkinTone', depth: 3 },
  { text: 'EmojiPicker.ActiveEmoji', depth: 3 },
  { text: 'useSkinTone', depth: 3 },
  { text: 'useActiveEmoji', depth: 3 },
  { text: 'defaultEmojiDataResolver', depth: 3 },
  { text: 'createEmojiDataCache', depth: 3 },
  { text: 'getEmojiDetails', depth: 3 },
  { text: 'loadEmojiDetails', depth: 3 },
  { text: 'Differences from React', depth: 2 },
  { text: 'Credits', depth: 2 },
];

function attribute(name: string) {
  return { name, description: 'Can be targeted in CSS for styling.' };
}
---

<BaseLayout>
  <TopBar />
  <div class="mx-auto flex max-w-6xl gap-12 px-4 sm:px-6">
    <main class="docs min-w-0 flex-1 pb-24">
      <section class="pt-14 pb-6 md:pt-20">
        <p class="label-mono mb-4">Svelte 5 · unstyled · composable</p>
        <h1 class="text-4xl/tight font-semibold text-foreground md:text-5xl">
          An emoji picker for Svelte
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted-foreground">
          {site.description} A Svelte port of
          <a href={site.original} target="_blank" rel="noopener">
            Frimousse
          </a>{' '}
          by Liveblocks, with the same parts, data attributes and CSS variables.
        </p>
        <DemoFrame name="hero">
          <HeroDemo client:load />
        </DemoFrame>
      </section>

      <Heading as="h2" text="Installation" />
      <CodeBlock lang="bash" code="npm i @gyen/frimousse" />
      <p>
        Or with <code>pnpm add @gyen/frimousse</code>. It needs Svelte 5 and has no other
        dependencies.
      </p>

      <Heading as="h3" text="shadcn-svelte" />
      <p>
        If you use{' '}
        <a href="https://shadcn-svelte.com" target="_blank" rel="noopener">
          shadcn-svelte
        </a>
        , you can install a ready-made version that uses your theme's colors, with the shadcn-svelte
        CLI:
      </p>
      <CodeBlock lang="bash" code={shadcnCommand} />
      <p class="border-l-2 border-ember pl-4 text-sm text-muted-foreground">
        On SvelteKit 3, if the command fails with <code>File '$app/tsconfig' not found</code>, run
        <code>npx svelte-kit sync</code> first, then run it again. SvelteKit generates that file,
        and shadcn-svelte needs it for every component, not only this one.
      </p>
      <p>
        It adds <code>$lib/components/ui/emoji-picker</code> and installs
        <code>@gyen/frimousse</code> and <code>phosphor-svelte</code> (for the search and loading
        icons). Then use it like any other shadcn-svelte component:
      </p>
      <CodeBlock
        code={`
          <script lang="ts">
            import * as EmojiPicker from "$lib/components/ui/emoji-picker";
          </script>

          <EmojiPicker.Root
            class="h-85.5 rounded-lg border shadow-md"
            onEmojiSelect={({ emoji }) => console.log(emoji)}
          >
            <EmojiPicker.Search />
            <EmojiPicker.Content />
            <EmojiPicker.Footer />
          </EmojiPicker.Root>
        `}
      />

      <Heading as="h2" text="Usage" />
      <p>
        Import the <code>EmojiPicker</code> parts and build your own component by putting them
        together.
      </p>
      <CodeBlock
        code={`
          <script lang="ts">
            import { EmojiPicker } from "@gyen/frimousse";
          </script>

          <EmojiPicker.Root onEmojiSelect={({ emoji }) => console.log(emoji)}>
            <EmojiPicker.Search />
            <EmojiPicker.Viewport>
              <EmojiPicker.Loading>Loading…</EmojiPicker.Loading>
              <EmojiPicker.Empty>
                No emoji found.
              </EmojiPicker.Empty>
              <EmojiPicker.List />
            </EmojiPicker.Viewport>
          </EmojiPicker.Root>
        `}
      />
      <p>
        Apart from a few size and overflow defaults, the parts have no styles. Style them any way
        you like: Tailwind CSS classes, your own classes, inline styles, or the
        <code>[frimousse-*]</code> attributes on each part. The inner parts of the list (category
        headers, rows and emoji buttons) are <a href="#emojipicker.list">snippets</a>: spread the
        <code>props</code> you get on your own element.
      </p>
      <DemoFrame name="usage" label="Tailwind CSS">
        <UsageDemo client:visible />
      </DemoFrame>
      <CodeBlock
        title="my-emoji-picker.svelte"
        code={`
          <script lang="ts">
            import { EmojiPicker } from "@gyen/frimousse";
          </script>

          <EmojiPicker.Root class="isolate flex h-92 w-fit flex-col bg-white dark:bg-neutral-900">
            <EmojiPicker.Search
              class="z-10 mx-2 mt-2 appearance-none rounded-md bg-neutral-100 px-2.5 py-2 text-sm dark:bg-neutral-800"
            />
            <EmojiPicker.Viewport class="relative flex-1 outline-hidden">
              <EmojiPicker.Loading class="absolute inset-0 flex items-center justify-center text-sm text-neutral-400">
                Loading…
              </EmojiPicker.Loading>
              <EmojiPicker.Empty class="absolute inset-0 flex items-center justify-center text-sm text-neutral-400">
                No emoji found.
              </EmojiPicker.Empty>
              <EmojiPicker.List class="pb-1.5 select-none">
                {#snippet categoryHeader({ category, props })}
                  <div {...props} class="bg-white px-3 pt-3 pb-1.5 text-xs font-medium text-neutral-600 dark:bg-neutral-900">
                    {category.label}
                  </div>
                {/snippet}
                {#snippet row({ props, children })}
                  <div {...props} class="scroll-my-1.5 px-1.5">{@render children()}</div>
                {/snippet}
                {#snippet emoji({ emoji, props })}
                  <button
                    {...props}
                    class="flex size-8 items-center justify-center rounded-md text-lg data-active:bg-neutral-100 dark:data-active:bg-neutral-800"
                  >
                    {emoji.emoji}
                  </button>
                {/snippet}
              </EmojiPicker.List>
            </EmojiPicker.Viewport>
          </EmojiPicker.Root>
        `}
      />
      <p>The same design in plain CSS, using the attributes:</p>
      <CodeBlock
        lang="css"
        code={`
          [frimousse-root] {
            display: flex;
            flex-direction: column;
            width: fit-content;
            height: 352px;
            background: light-dark(#fff, #171717);
            isolation: isolate;
          }

          [frimousse-search] {
            position: relative;
            z-index: 10;
            appearance: none;
            margin: 8px 8px 0;
            padding: 8px 10px;
            background: light-dark(#f5f5f5, #262626);
            border-radius: 6px;
            font-size: 14px;
          }

          [frimousse-viewport] {
            position: relative;
            flex: 1;
            outline: none;
          }

          [frimousse-loading],
          [frimousse-empty] {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: light-dark(#a1a1a1, #737373);
            font-size: 14px;
          }

          [frimousse-list] {
            padding-block-end: 12px;
            user-select: none;
          }

          [frimousse-category-header] {
            padding: 12px 12px 6px;
            background: light-dark(#fff, #171717);
            color: light-dark(#525252, #a1a1a1);
            font-size: 12px;
            font-weight: 500;
          }

          [frimousse-row] {
            padding-inline: 12px;
            scroll-margin-block: 12px;
          }

          [frimousse-emoji] {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: transparent;
            font-size: 18px;

            &[data-active] {
              background: light-dark(#f5f5f5, #262626);
            }
          }
        `}
      />

      <Heading as="h3" text="Options" />
      <p>
        Options for the whole picker are props on <code>EmojiPicker.Root</code>. Try them here; the
        <code>skinTone</code> prop is bound with <code>bind:skinTone</code>, so it also follows the
        ✋ button inside the picker.
      </p>
      <DemoFrame name="options">
        <OptionsDemo client:visible />
      </DemoFrame>
      <CodeBlock
        code={`
          <script lang="ts">
            import { EmojiPicker, type SkinTone } from "@gyen/frimousse";

            let skinTone = $state<SkinTone>("none");
          </script>

          <EmojiPicker.Root locale="fr" columns={10} bind:skinTone>
            <!-- ... -->
            <EmojiPicker.SkinToneSelector />
          </EmojiPicker.Root>
        `}
      />

      <Heading as="h3" text="In a popover" />
      <p>
        Frimousse is only the picker. To show it in a popover, use the popover you already have, for
        example{' '}
        <a href="https://bits-ui.com/docs/components/popover" target="_blank" rel="noopener">
          Bits UI
        </a>{' '}
        or the shadcn-svelte <code>Popover</code> (which is built on it).
      </p>
      <DemoFrame name="popover">
        <PopoverDemo client:visible />
      </DemoFrame>
      <CodeBlock
        code={`
          <script lang="ts">
            import * as Popover from "$lib/components/ui/popover";
            import { Button } from "$lib/components/ui/button";
            import * as EmojiPicker from "$lib/components/ui/emoji-picker";

            let open = $state(false);
          </script>

          <Popover.Root bind:open>
            <Popover.Trigger>
              {#snippet child({ props })}
                <Button {...props}>Open emoji picker</Button>
              {/snippet}
            </Popover.Trigger>
            <Popover.Content class="w-fit p-0">
              <EmojiPicker.Root
                class="h-85.5"
                onEmojiSelect={({ emoji }) => {
                  open = false;
                  console.log(emoji);
                }}
              >
                <EmojiPicker.Search />
                <EmojiPicker.Content />
                <EmojiPicker.Footer />
              </EmojiPicker.Root>
            </Popover.Content>
          </Popover.Root>
        `}
      />

      <Heading as="h3" text="Custom data sources and locales" />
      <p>
        Use the{' '}
        <a href="#emojipicker.root-props">
          <code>resolveEmojiData</code>
        </a>{' '}
        prop to load emoji data from your own source, or to support locales that
        <a href="https://emojibase.dev" target="_blank" rel="noopener">
          Emojibase
        </a>{' '}
        doesn't have. Return your data for the locales you handle, and pass the rest to
        <a href="#defaultemojidataresolver">
          <code>defaultEmojiDataResolver</code>
        </a>
        .
      </p>
      <CodeBlock
        code={`
          <script lang="ts">
            import { defaultEmojiDataResolver, EmojiPicker } from "@gyen/frimousse";
            import { emojiData } from "./emoji-data";
          </script>

          <EmojiPicker.Root
            locale="ne"
            resolveEmojiData={(locale, options) =>
              locale === "ne" ? emojiData : defaultEmojiDataResolver(locale, options)}
          >
            <!-- ... -->
          </EmojiPicker.Root>
        `}
      />
      <p>
        The data uses the <code>EmojiData</code> type. For example, <code>emoji-data.ts</code>:
      </p>
      <CodeBlock
        lang="ts"
        code={`
          import type { EmojiData } from "@gyen/frimousse";

          export const emojiData: EmojiData = {
            locale: "ne",
            emojis: [
              {
                emoji: "😀",
                label: "हाँसेको अनुहार",
                tags: ["खुसी"],
                category: 0,
                version: 1,
              },
            ],
            categories: [{ index: 0, label: "अनुहारहरू" }],
            skinTones: {
              light: "हल्का",
              "medium-light": "मध्यम हल्का",
              medium: "मध्यम",
              "medium-dark": "मध्यम गाढा",
              dark: "गाढा",
            },
          };
        `}
      />
      <p>
        Each emoji's <code>category</code> matches a category's <code>index</code>. Category labels
        and
        <code>skinTones</code> are the localized names the picker shows. The data must describe
        standard Unicode emojis shown as text; image and sprite emojis aren't supported.
      </p>
      <p>
        Any string works as a locale. The default resolver falls back to <code>en</code> when
        Emojibase doesn't support it. Custom data is used as it is: if you need to, remove emoji
        versions and country flags the browser can't show before you return it. A resolver can
        return the data or a promise. To cache custom data in the browser, use{' '}
        <a href="#createemojidatacache">
          <code>createEmojiDataCache</code>
        </a>
        .
      </p>

      <Heading as="h3" text="Looking up an emoji" />
      <p>
        Use{' '}
        <a href="#loademojidetails">
          <code>loadEmojiDetails</code>
        </a>{' '}
        to get a stored emoji's localized label and search tags, for example to show a tooltip on a
        reaction. It works without a picker and shares loaded data with pickers that use the same
        locale and source.
      </p>
      <CodeBlock
        code={`
          <script lang="ts">
            import { loadEmojiDetails } from "@gyen/frimousse";
          </script>

          {#await loadEmojiDetails("👍🏽", { locale: "en" })}
            <span>Loading…</span>
          {:then details}
            <span>{details?.label ?? "Unknown emoji"}</span>
          {:catch}
            <span>Could not load emoji</span>
          {/await}
        `}
      />
      <p>
        Skin tone versions return the details of the base emoji, and <code>❤</code> and{' '}
        <code>❤️</code>
        match the same emoji. If there is no match, the promise resolves to <code>undefined</code>.
      </p>
      <p>
        For a synchronous lookup, use{' '}
        <a href="#getemojidetails">
          <code>getEmojiDetails</code>
        </a>
        . It only reads data a picker or <code>loadEmojiDetails</code> already loaded, and returns
        <code>undefined</code> until then. Both include emojis the browser can't show.
      </p>
      <CodeBlock
        lang="ts"
        code={`
          import { getEmojiDetails } from "@gyen/frimousse";

          const details = getEmojiDetails("👍🏽", { locale: "en" });
        `}
      />

      <Heading as="h2" text="Styling" />

      <Heading as="h3" text="Dimensions" />
      <p>
        The picker doesn't need fixed sizes. It measures its contents (the number of columns, the
        row height, the padding in the sticky category headers…) and sizes itself to fit. Keep the
        <a href="#emojipicker.list-snippets">inner parts</a> of the list the same size (for example,
        every row the same height) so the layout doesn't jump.
      </p>
      <p>
        Use the{' '}
        <a href="#emojipicker.root-css-variables">
          <code>--frimousse-viewport-width</code>
        </a>
        CSS variable as a <code>max-width</code> to keep other areas, like the active emoji's name
        below the list, from growing wider than the picker. You can still force a width, for example
        to fill the screen on phones.
      </p>

      <Heading as="h3" text="List padding" />
      <p>
        Because the list is virtualized, padding on <code>EmojiPicker.List</code> itself is tricky.
        Put horizontal padding on rows and category headers, and vertical padding on the list. To
        keep the same vertical space when keyboard navigation scrolls to a row, set the same value
        as
        <code>scroll-margin-block</code> on rows.
      </p>

      <Heading as="h3" text="Colorful buttons" />
      <p>
        Some pickers, like Slack's, give active emojis a background color that seems random. You can
        get the same effect with <code>:nth-child</code> selectors on rows and emojis: each row
        cycles red, green, blue, and every other row starts one color later so columns don't share a
        color. Hover the emojis below.
      </p>
      <DemoFrame name="colorful">
        <ColorfulDemo client:visible />
      </DemoFrame>

      <Heading as="h2" text="API Reference" />
      <p>All parts, helpers and types, with how to use them and their options.</p>

      <Heading as="h3" text="EmojiPicker.Root" />
      <p>Wraps all the picker parts.</p>
      <CodeBlock
        code={`
          <EmojiPicker.Root onEmojiSelect={({ emoji }) => console.log(emoji)}>
            <EmojiPicker.Search />
            <EmojiPicker.Viewport>
              <EmojiPicker.List />
            </EmojiPicker.Viewport>
          </EmojiPicker.Root>
        `}
      />
      <Heading as="h4" prefix="EmojiPicker.Root" text="Props" />
      <PropsTable
        rows={[
          {
            name: 'onEmojiSelect',
            type: '(emoji: Emoji) => void',
            description: 'Called when an emoji is selected.',
          },
          {
            name: 'locale',
            type: 'Locale',
            default: '"en"',
            description:
              "The locale of the picker. Any string works; locales Emojibase doesn't support can be used with a custom <code>resolveEmojiData</code>.",
          },
          {
            name: 'skinTone',
            type: 'SkinTone',
            default: '"none"',
            description:
              'The skin tone of the picker. Bindable: <code>bind:skinTone</code> also picks up changes made inside the picker.',
          },
          {
            name: 'columns',
            type: 'number',
            default: '9',
            description: 'The number of columns in the list.',
          },
          {
            name: 'sticky',
            type: 'boolean',
            default: 'true',
            description: 'Whether the category headers are sticky.',
          },
          {
            name: 'emojiVersion',
            type: 'number',
            default: 'the newest version the browser supports',
            description:
              'Which <a href="https://emojipedia.org/emoji-versions" target="_blank" rel="noopener">Emoji version</a> to use, to choose which emojis show regardless of what the browser supports. With a custom <code>resolveEmojiData</code>, the value is passed to the resolver, which does the filtering.',
          },
          {
            name: 'emojibaseUrl',
            type: 'string',
            default: '"https://cdn.jsdelivr.net/npm/emojibase-data"',
            description:
              'Where the <a href="https://emojibase.dev/docs/datasets/" target="_blank" rel="noopener">Emojibase data</a> is fetched from, as <code>${emojibaseUrl}/${locale}/${file}.json</code>. Point it at another CDN that hosts the <code>emojibase-data</code> package, or at your own copy; if you only use one locale, you only need to host that locale\'s folder.',
          },
          {
            name: 'resolveEmojiData',
            type: 'EmojiDataResolver',
            default: 'defaultEmojiDataResolver',
            description:
              'Returns <code>EmojiData</code> (or a promise of it) for the locale. It receives the locale and <code>{ emojiVersion, emojibaseUrl, signal }</code>; pass <code>signal</code> to <code>fetch</code>, as it is aborted when the picker unmounts or reloads. It runs on mount and when <code>locale</code>, <code>emojiVersion</code> or <code>emojibaseUrl</code> changes; changing only the function doesn\'t reload. See <a href="#custom-data-sources-and-locales">custom data sources and locales</a>.',
          },
          {
            name: 'ref',
            type: 'HTMLDivElement | null',
            description: 'Bindable. The root element.',
          },
          { name: '…', description: 'All <code>div</code> attributes.' },
        ]}
      />
      <Heading as="h4" prefix="EmojiPicker.Root" text="Attributes" />
      <PropsTable
        rows={[
          attribute('[frimousse-root]'),
          {
            name: '[data-focused]',
            description: 'Present when the search or the viewport has focus.',
          },
        ]}
      />
      <Heading as="h4" prefix="EmojiPicker.Root" text="CSS Variables" />
      <PropsTable
        rows={[
          {
            name: '--frimousse-emoji-font',
            type: '<string>',
            description: 'The font families used to show emojis.',
          },
          {
            name: '--frimousse-viewport-width',
            type: '<length>',
            description: 'The measured width of the viewport.',
          },
          {
            name: '--frimousse-viewport-height',
            type: '<length>',
            description: 'The measured height of the viewport.',
          },
          {
            name: '--frimousse-row-height',
            type: '<length>',
            description: 'The measured height of a row.',
          },
          {
            name: '--frimousse-category-header-height',
            type: '<length>',
            description: 'The measured height of a category header.',
          },
        ]}
      />

      <Heading as="h3" text="EmojiPicker.Search" />
      <p>A search input that filters the emojis.</p>
      <CodeBlock
        code={`
          <script lang="ts">
            import { EmojiPicker } from "@gyen/frimousse";

            let search = $state("");
          </script>

          <EmojiPicker.Root>
            <EmojiPicker.Search bind:value={search} />
            <!-- ... -->
          </EmojiPicker.Root>
        `}
      />
      <Heading as="h4" prefix="EmojiPicker.Search" text="Props" />
      <PropsTable
        rows={[
          {
            name: 'value',
            type: 'string',
            default: '""',
            description:
              'The search text. Pass it to set a starting value, or use <code>bind:value</code> to control it.',
          },
          {
            name: 'ref',
            type: 'HTMLInputElement | null',
            description: 'Bindable. The input element.',
          },
          { name: '…', description: 'All <code>input</code> attributes.' },
        ]}
      />
      <Heading as="h4" prefix="EmojiPicker.Search" text="Attributes" />
      <PropsTable rows={[attribute('[frimousse-search]')]} />

      <Heading as="h3" text="EmojiPicker.Viewport" />
      <p>The scrolling container of the picker.</p>
      <CodeBlock
        code={`
          <EmojiPicker.Viewport>
            <EmojiPicker.Loading>Loading…</EmojiPicker.Loading>
            <EmojiPicker.Empty>No emoji found.</EmojiPicker.Empty>
            <EmojiPicker.List />
          </EmojiPicker.Viewport>
        `}
      />
      <Heading as="h4" prefix="EmojiPicker.Viewport" text="Props" />
      <PropsTable
        rows={[
          {
            name: 'ref',
