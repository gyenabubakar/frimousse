      <Heading as="h3" text="EmojiPicker.SkinTone" />
      <p>
        Gives a snippet the current skin tone, a function to change it, and the skin tone versions
        of an emoji, to build your own skin tone selector.
      </p>
      <DemoFrame name="custom-skin-tone">
        <CustomSkinToneDemo client:visible />
      </DemoFrame>
      <CodeBlock
        code={`
          <EmojiPicker.SkinTone emoji="👋">
            {#snippet children({ skinTone, setSkinTone, skinToneVariations })}
              {#each skinToneVariations as variation (variation.skinTone)}
                <button
                  aria-pressed={variation.skinTone === skinTone}
                  onclick={() => setSkinTone(variation.skinTone)}
                >
                  {variation.emoji}
                </button>
              {/each}
            {/snippet}
          </EmojiPicker.SkinTone>
        `}
