      <CodeBlock code={`<EmojiPicker.SkinToneSelector emoji="👋" />`} />
      <p>
        To build your own skin tone selector, use{' '}
        <a href="#emojipicker.skintone">
          <code>EmojiPicker.SkinTone</code>
        </a>{' '}
        or{' '}
        <a href="#useskintone">
          <code>useSkinTone</code>
        </a>
        .
      </p>
      <Heading as="h4" prefix="EmojiPicker.SkinToneSelector" text="Props" />
