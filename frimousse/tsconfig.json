{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext makes svelte-check require full file endings in relative imports. Without them, the published
    // types break for consumers using `moduleResolution: "nodenext"`.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@vitest/browser-playwright"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}
