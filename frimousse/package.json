{
  "name": "@gyen/frimousse",
  "description": "A lightweight, unstyled, and composable emoji picker for Svelte. A Svelte 5 port of Liveblocks' Frimousse.",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "svelte-package --input src --output dist && publint --strict",
    "dev": "svelte-package --input src --output dist --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "prepublishOnly": "pnpm build && pnpm test && pnpm check"
  },
  "peerDependencies": {
    "svelte": "^5.25.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "emojibase-data": "^16.0.3",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  },
  "bugs": {
    "url": "https://github.com/gyenabubakar/frimousse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyenabubakar/frimousse.git",
    "directory": "frimousse"
  },
  "homepage": "https://frimousse.gyen.dev",
  "keywords": [
    "emoji",
    "emoji picker",
    "svelte",
    "svelte5",
    "unstyled",
    "component",
    "emojibase",
    "frimousse"
  ]
}
